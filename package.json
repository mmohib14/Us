{
  "name": "apexgutters-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs server.ts --dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/tsx/dist/cli.mjs server.ts --production",
    "preview": "npm run start",
    "clean": "node -e \"const fs=require('node:fs'); for(const path of ['out','.next','tsconfig.tsbuildinfo']) fs.rmSync(path,{recursive:true,force:true})\"",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-three/fiber": "^9.8.2",
    "@types/three": "^0.186.0",
    "animate.css": "^4.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lottie-react": "^3.1.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-move": "^6.5.0",
    "three": "^0.186.1",
    "@tailwindcss/postcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
