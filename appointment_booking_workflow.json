        [
          { "node": "MySQL: Check Service Area", "type": "main", "index": 0 }
        ],
        [
          { "node": "Create Customer if Needed", "type": "main", "index": 0 }
        ]
      ]
    },
    "Create Customer if Needed": {
      "main": [
        [
          { "node": "MySQL: Check Service Area", "type": "main", "index": 0 }
        ]
      ]
    },
    "MySQL: Check Service Area": {
      "main": [
        [
          { "node": "IF: Service Area Supported?", "type": "main", "index": 0 }
        ]
      ]
    },
    "IF: Service Area Supported?": {
      "main": [
        [
          { "node": "MySQL: Check Availability", "type": "main", "index": 0 }
        ],
        [
          { "node": "Respond to Website - ZIP Unsupported", "type": "main", "index": 0 }
        ]
      ]
    },
    "MySQL: Check Availability": {
      "main": [
        [
          { "node": "IF: Slot Available?", "type": "main", "index": 0 }
        ]
      ]
    },
    "IF: Slot Available?": {
      "main": [
        [
          { "node": "Reserve Appointment Safely", "type": "main", "index": 0 }
        ],
        [
          { "node": "Respond to Website - Slot Unavailable", "type": "main", "index": 0 }
        ]
      ]
    },
    "Reserve Appointment Safely": {
      "main": [
        [
          { "node": "MySQL: Save Appointment", "type": "main", "index": 0 }
        ]
      ]
    },
    "MySQL: Save Appointment": {
