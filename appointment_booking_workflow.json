          { "node": "Respond to Website - Database Error", "type": "main", "index": 0 }
        ]
      ]
    },
    "Send Customer Confirmation": {
      "main": [
        [
          { "node": "Notify Admin", "type": "main", "index": 0 }
        ]
      ]
    },
    "Notify Admin": {
